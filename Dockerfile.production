# Production-ready Dockerfile for amd64 deployment
# Optimized multi-stage build with all dependencies included

# Base stage
FROM oven/bun:1-alpine AS base
WORKDIR /usr/src/app

# Install stage - install dependencies
FROM base AS install
RUN mkdir -p /temp/dev
COPY package.json bun.lock /temp/dev/
RUN cd /temp/dev && bun install --frozen-lockfile

# Build stage
FROM base AS build
COPY --from=install /temp/dev/node_modules node_modules
COPY . .

# Set production environment
ENV NODE_ENV=production

# Build the production bundle
RUN bun run build

# Release stage - Production runtime with Nginx
FROM nginx:alpine AS release

# Copy built static files from build stage
COPY --from=build /usr/src/app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Create logs directory with proper permissions
RUN mkdir -p /var/log/nginx && \
    touch /var/log/nginx/access.log && \
    touch /var/log/nginx/error.log && \
    touch /var/log/nginx/api_access.log && \
    chmod -R 755 /var/log/nginx

# Expose port
EXPOSE 80

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
