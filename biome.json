{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "!!tools/oxlint/anti-slop",
      "!public/games/fall-line/index.html",
      "!public/games/terrabrowser",
      "!public/games/ponpoko-kart",
      "!public/games/emberwake",
      "!public/games/build-your-town",
      "!public/games/chess-3d",
      "!public/games/nova-lancer",
      "!public/games/sunbreak",
      "!public/games/arkanoid-neon",
      "!public/games/hearthvale",
      "!public/games/gravewake",
      "!public/games/dynamite-mole",
      "!public/games/yet-another-voxelcraft",
      "!public/games/pokemon-claude-red"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": "off",
        "useDestructuring": "off",
        "noIncrementDecrement": "off",
        "useUnicodeRegex": "off",
        "useNamedCaptureGroup": "off",
        "useImportsFirst": "off",
        "useDomQuerySelector": "off",
        "useThisInClassMethods": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useBaseline": "off",
        "noDuplicateSelectors": "off",
        "noLoopFunc": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tools/**/*.ts", "tools/**/*.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": ["public/**/*.html"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["public/**/*.svg"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "src/components/ui/**",
        "src/components/kokonutui/**",
        "src/hooks/**"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useAriaPropsForRole": "off",
            "noRedundantRoles": "off",
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "complexity": {
            "useSimplifiedLogicExpression": "off",
            "noExcessiveCognitiveComplexity": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "nursery": {
            "useTailwindSortedClasses": "off"
          },
          "style": {
            "useImportType": "off",
            "useBlockStatements": "off",
            "useConsistentObjectDefinitions": "off",
            "useConsistentTypeDefinitions": "off",
            "noNegationElse": "off",
            "noNestedTernary": "off",
            "noMagicNumbers": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off",
            "noArrayIndexKey": "off",
            "noApproximativeNumericConstant": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["src/components/kibo-ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["src/index.css"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownTypeSelector": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentBuiltinInstantiation": "off",
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/examples/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noAlert": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/pages/dashboard/arkanoid-neon.tsx",
        "src/pages/dashboard/build-your-town.tsx",
        "src/pages/dashboard/chess-3d.tsx",
        "src/pages/dashboard/dynamite-mole.tsx",
        "src/pages/dashboard/emberwake.tsx",
        "src/pages/dashboard/gravewake.tsx",
        "src/pages/dashboard/hearthvale.tsx",
        "src/pages/dashboard/nova-lancer.tsx",
        "src/pages/dashboard/pokemon-claude-red.tsx",
        "src/pages/dashboard/ponpoko-kart.tsx",
        "src/pages/dashboard/sunbreak.tsx",
        "src/pages/dashboard/terrabrowser.tsx",
        "src/pages/dashboard/yet-another-voxelcraft.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "useIframeSandbox": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ui/field.tsx",
        "src/components/ui/form.tsx",
        "src/features/developer-tools/tools/date-converter/components/date-picker-popover.tsx",
        "src/features/developer-tools/tools/number-base-converter/components/number-base-converter.tsx",
        "src/features/developer-tools/tools/qris-mdr-calculator/components/qris-mdr-calculator.tsx",
        "src/features/log-viewer/log-toolbar.tsx",
        "src/features/overview/components/user-status-chart.tsx",
        "src/features/simulator-db/components/row-edit-dialog.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
