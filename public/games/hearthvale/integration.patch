-    if (q) return q;
-    const s = localStorage.getItem('hearthvale.server');
-    if (s) return s;
-  } catch {
-    /* ignore */
-  }
-  const proto = location.protocol === 'https:' ? 'wss' : 'ws';
-  const host = location.hostname || '127.0.0.1';
-  return `${proto}://${host}:8787/ws`;
+  return 'managed';
+}
+
+function connectionUrl(signal: AbortSignal): Promise<string> {
+  return new Promise((resolve, reject) => {
+    if (window.parent === window) {
+      reject(new Error('Open Hearthvale from the dashboard to play co-op'));
+      return;
+    }
+    const bytes = crypto.getRandomValues(new Uint8Array(16));
+    bytes[6] = (bytes[6]! & 15) | 64;
+    bytes[8] = (bytes[8]! & 63) | 128;
+    const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
+    const id = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+    const cleanup = (): void => {
+      window.removeEventListener('message', receive);
+      signal.removeEventListener('abort', cancel);
+      clearTimeout(timer);
+    };
+    const cancel = (): void => {
+      cleanup();
+      reject(new Error('Connection cancelled'));
+    };
+    const receive = (event: MessageEvent): void => {
+      if (event.source !== window.parent || event.origin !== location.origin) return;
+      const data = event.data as { type?: string; id?: string; url?: string; error?: string } | null;
+      if (!data || data.type !== 'hearthvale:connection' || data.id !== id) return;
+      cleanup();
+      if (typeof data.url === 'string') resolve(data.url);
+      else reject(new Error(typeof data.error === 'string' ? data.error : 'Co-op connection unavailable'));
+    };
+    const timer = setTimeout(() => {
+      cleanup();
+      reject(new Error('The dashboard did not answer the co-op connection request'));
+    }, 10000);
+    window.addEventListener('message', receive);
+    signal.addEventListener('abort', cancel, { once: true });
+    window.parent.postMessage({ type: 'hearthvale:connect', id }, location.origin);
+  });
@@ -73,0 +102 @@ export class Transport {
+  private connectionAttempt: AbortController | null = null;
@@ -182 +211,10 @@ export class Transport {
-    this.sock.open(this.url);
+    this.connectionAttempt?.abort();
+    const attempt = new AbortController();
+    this.connectionAttempt = attempt;
+    void connectionUrl(attempt.signal).then((url) => {
+      if (!attempt.signal.aborted && !this.closedByUser) this.sock.open(url);
+    }).catch((error: Error) => {
+      if (attempt.signal.aborted || this.closedByUser) return;
+      if (this.retry >= 10) this.h.ctrl({ t: 'error', code: 'connection', text: error.message });
+      else this.onClose();
+    });
